# Copy to .env next to docker-compose.yml. Never commit .env.

# Database password. Generate one, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Signing key for access tokens, at least 32 bytes. Generate: openssl rand -base64 48
# Changing it signs everyone out of the app (they log in again; nothing is lost).
GYMBUDDY_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes

# The admin: created as an approved admin on first start, then approves everyone else on /admin.
# The password (at least 12 characters) is only used to create the account; changing it later here has no effect.
GYMBUDDY_ADMIN_EMAIL=you@example.com
GYMBUDDY_ADMIN_PASSWORD=change-me-to-a-long-password

# "Keep me logged in": how long a login lasts after the app was last opened (every open starts it over).
# Examples: 30d, 14d, 90d. The login screen says 30 days; change NUXT_PUBLIC_REMEMBER_DAYS in the web build to match.
GYMBUDDY_REMEMBER_ME_TTL=30d

# The public web address, for CORS. The iOS app (capacitor://localhost) is always allowed.
GYMBUDDY_WEB_ORIGIN=https://gymbuddy.example.nl

# Cloudflare Tunnel token (Synology only): Zero Trust dashboard → Networks → Tunnels → your tunnel.
# Point the tunnel's public hostname at http://caddy:80.
TUNNEL_TOKEN=

# Caddy site address. Keep :80 behind the tunnel; on a VPS use the domain (gymbuddy.example.nl) for automatic HTTPS.
SITE_ADDRESS=:80
# Host ports. On a VPS use 80 and 443.
HTTP_PORT=8088
HTTPS_PORT=8443

# Images pushed by GitHub Actions. Use a commit SHA as IMAGE_TAG to pin or roll back a release.
IMAGE_PREFIX=ghcr.io/arieveek
IMAGE_TAG=latest

TZ=Europe/Amsterdam
BACKUP_KEEP_DAYS=14
